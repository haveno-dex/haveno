<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import haveno.desktop.components.AutoTooltipLabel?>
<GridPane fx:id="root" fx:controller="haveno.desktop.main.settings.network.NetworkSettingsView"
          styleClass="network-settings" xmlns:fx="http://javafx.com/fxml">
    <columnConstraints><ColumnConstraints hgrow="ALWAYS" minWidth="0"/></columnConstraints>
    <VBox spacing="30" GridPane.hgrow="ALWAYS">
        <VBox>
            <HBox styleClass="network-heading" alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="moneroHeading" styleClass="network-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="moneroStatus" styleClass="network-health"/>
                <Label text="│" styleClass="network-divider"/>
                <Label fx:id="blockHeight" styleClass="network-help"/>
                <Label fx:id="routeDivider" text="│" styleClass="network-divider"/>
                <Label fx:id="route" styleClass="network-help"/>
            </HBox>
            <VBox fx:id="statusNote" styleClass="network-status-note" spacing="2">
                <VBox.margin><Insets bottom="14"/></VBox.margin>
                <Label fx:id="statusTitle" styleClass="network-setting-title" wrapText="true"/>
                <Label fx:id="statusDetail" styleClass="network-help" wrapText="true"/>
            </VBox>
            <HBox styleClass="network-source-row" alignment="CENTER_LEFT" spacing="32">
                <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                    <Label fx:id="sourceLabel" styleClass="network-setting-title"/>
                    <TextFlow>
                        <Text fx:id="sourceHelp" styleClass="network-source-help"/>
                        <Hyperlink fx:id="remoteNodeLink" styleClass="network-link"/>
                    </TextFlow>
                </VBox>
                <ComboBox fx:id="source" styleClass="network-select" minWidth="300" prefWidth="300" maxWidth="300"/>
            </HBox>
            <StackPane styleClass="network-table-frame">
                <VBox fx:id="nodeCard">
                    <TableView fx:id="moneroConnectionsTableView" styleClass="network-table,network-nodes">
                        <columns>
                            <TableColumn fx:id="nodeAddressColumn" minWidth="180"/>
                            <TableColumn fx:id="nodeLatencyColumn" minWidth="130" prefWidth="130" maxWidth="130" styleClass="network-number"/>
                            <TableColumn fx:id="nodeStatusColumn" minWidth="150" prefWidth="150" maxWidth="150"/>
                            <TableColumn fx:id="nodeActionsColumn" minWidth="46" prefWidth="46" maxWidth="46" sortable="false"/>
                        </columns>
                    </TableView>
                    <HBox fx:id="addRow" styleClass="network-add-row">
                        <TextField fx:id="addInput" styleClass="network-add-field" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="addButton" styleClass="network-button"/>
                    </HBox>
                </VBox>
            </StackPane>
            <Label fx:id="addHint" styleClass="network-hint" wrapText="true"/>
            <Label fx:id="selectionNote" styleClass="network-selection-note" wrapText="true"/>
            <VBox styleClass="network-settings-rows">
                <HBox alignment="CENTER_LEFT" spacing="32">
                    <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="torLabel" styleClass="network-setting-title"/>
                        <Label fx:id="torHelp" styleClass="network-help" wrapText="true"/>
                    </VBox>
                    <ComboBox fx:id="tor" styleClass="network-select" minWidth="300" prefWidth="300" maxWidth="300"/>
                </HBox>
                <HBox fx:id="torPending" styleClass="network-tor-pending">
                    <VBox.margin><Insets top="12"/></VBox.margin>
                    <Label fx:id="pendingText" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="shutdownButton" styleClass="network-button"/>
                </HBox>
            </VBox>
        </VBox>
        <VBox styleClass="network-p2p-section">
            <HBox styleClass="network-heading" alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="havenoHeading" styleClass="network-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="havenoStatus" styleClass="network-health"/>
                <Label text="│" styleClass="network-divider"/>
                <Hyperlink fx:id="openTorSettingsButton" styleClass="network-link"/>
            </HBox>
            <HBox styleClass="network-stats" spacing="28">
                <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label fx:id="ownAddressLabel" styleClass="network-stat-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <AutoTooltipLabel fx:id="ownAddress" minWidth="0"/>
                        <Button fx:id="copyAddressButton" styleClass="network-icon-button"/>
                    </HBox>
                </VBox>
                <VBox spacing="4" minWidth="190" prefWidth="240" maxWidth="240">
                    <Label fx:id="sentLabel" styleClass="network-stat-label"/>
                    <FlowPane hgap="8" vgap="2">
                        <Label fx:id="sentTotal" styleClass="network-stat-value"/>
                        <Label fx:id="sentMessages" styleClass="network-stat-detail"/>
                    </FlowPane>
                </VBox>
                <VBox spacing="4" minWidth="190" prefWidth="240" maxWidth="240">
                    <Label fx:id="receivedLabel" styleClass="network-stat-label"/>
                    <FlowPane hgap="8" vgap="2">
                        <Label fx:id="receivedTotal" styleClass="network-stat-value"/>
                        <Label fx:id="receivedMessages" styleClass="network-stat-detail"/>
                    </FlowPane>
                </VBox>
            </HBox>
            <Label fx:id="peersLabel" styleClass="network-table-label"/>
            <StackPane styleClass="network-table-frame">
                <TableView fx:id="p2pPeersTableView" styleClass="network-table" fixedCellSize="40">
                    <columns>
                        <TableColumn fx:id="peerAddressColumn" minWidth="100"/>
                        <TableColumn fx:id="peerTypeColumn" minWidth="190" prefWidth="190" maxWidth="190"/>
                        <TableColumn fx:id="peerDirectionColumn" minWidth="110" prefWidth="110" maxWidth="110"/>
                        <TableColumn fx:id="peerSinceColumn" minWidth="110" prefWidth="110" maxWidth="110"/>
                        <TableColumn fx:id="peerLatencyColumn" minWidth="100" prefWidth="100" maxWidth="100" styleClass="network-number"/>
                        <TableColumn fx:id="peerSentColumn" minWidth="96" prefWidth="96" maxWidth="96" styleClass="network-number"/>
                        <TableColumn fx:id="peerReceivedColumn" minWidth="104" prefWidth="104" maxWidth="104" styleClass="network-number"/>
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </VBox>
</GridPane>
